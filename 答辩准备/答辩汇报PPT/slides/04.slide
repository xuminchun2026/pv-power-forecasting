<Slide style={{ padding: '0px' }}>
  <Box style={{ width: '100%', height: 10, background: '#0E3F8C' }} />
  <Box style={{ padding: '30px 40px 0px 40px' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1E4FA8' }}>二、实验数据：PVOD 河北 10 站，一年 15 分钟一条</Text>
  </Box>
  <Box style={{ padding: '20px 40px 0px 40px' }}>
    <Box style={{ flexDirection: 'row', gap: 22 }}>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
        <Box style={{ flexDirection: 'row', gap: 14 }}>
          <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '16px 18px', flexDirection: 'column', gap: 2 }}>
            <Text style={{ fontSize: 19, color: '#4A5568' }}>总记录数</Text>
            <Text style={{ fontSize: 42, fontWeight: 'bold', color: '#1E4FA8' }}>271,803</Text>
            <Text style={{ fontSize: 17, color: '#8B97A8' }}>原始 271,968 行，剔 165 条后</Text>
          </Box>
          <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '16px 18px', flexDirection: 'column', gap: 2 }}>
            <Text style={{ fontSize: 19, color: '#4A5568' }}>总装机容量</Text>
            <Text style={{ fontSize: 42, fontWeight: 'bold', color: '#1E4FA8' }}>193.6</Text>
            <Text style={{ fontSize: 17, color: '#8B97A8' }}>MW，单站 6.6 ~ 35 MW</Text>
          </Box>
        </Box>
        <Box style={{ flexDirection: 'row', gap: 14 }}>
          <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '16px 18px', flexDirection: 'column', gap: 2 }}>
            <Text style={{ fontSize: 19, color: '#4A5568' }}>时间粒度</Text>
            <Text style={{ fontSize: 42, fontWeight: 'bold', color: '#1E4FA8' }}>15 min</Text>
            <Text style={{ fontSize: 17, color: '#8B97A8' }}>2018-06-30 至 2019-06-13</Text>
          </Box>
          <Box style={{ flex: 1, background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '16px 18px', flexDirection: 'column', gap: 2 }}>
            <Text style={{ fontSize: 19, color: '#4A5568' }}>气象变量</Text>
            <Text style={{ fontSize: 42, fontWeight: 'bold', color: '#1E4FA8' }}>13 个</Text>
            <Text style={{ fontSize: 17, color: '#8B97A8' }}>7 个预报 + 6 个站内实测</Text>
          </Box>
        </Box>
      </Box>
      <Box style={{ flex: 1.35, flexDirection: 'column', gap: 10 }}>
        <Image src="assets/typical_day.png" style={{ width: '100%', height: 256, objectFit: 'contain' }} />
      </Box>
    </Box>
    <Box style={{ marginTop: 18, flexDirection: 'row', gap: 20, alignItems: 'center' }}>
      <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 8, paddingLeft: 20, paddingRight: 20, paddingTop: 14, paddingBottom: 14, flexDirection: 'column', gap: 4 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1A2230' }}>为什么必须按容量归一化</Text>
        <Text style={{ fontSize: 19, color: '#4A5568', lineHeight: 1.5 }}>十站装机差 5 倍，直接比 MW 等于比谁电站大。统一除以装机容量，误差单位就是「占装机容量的百分比」。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 8, paddingLeft: 20, paddingRight: 20, paddingTop: 14, paddingBottom: 14, flexDirection: 'column', gap: 4 }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1A2230' }}>49.07% 的样本是夜间</Text>
        <Text style={{ fontSize: 19, color: '#4A5568', lineHeight: 1.5 }}>天黑停机是真实物理状态，不是缺失值，所以一条都没删；指标只在有发电的时段比较。</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', right: 40, bottom: 24 }}>
    <Text style={{ fontSize: 16, color: '#1E4FA8' }}>04 / 13</Text>
  </Box>
</Slide>
