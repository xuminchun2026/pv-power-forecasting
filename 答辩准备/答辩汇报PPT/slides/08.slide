<Slide style={{ padding: '0px' }}>
  <Box style={{ width: '100%', height: 10, background: '#0E3F8C' }} />
  <Box style={{ padding: '30px 40px 0px 40px' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1E4FA8' }}>第一个关键发现：实测换预报，误差几乎翻倍</Text>
  </Box>
  <Box style={{ padding: '20px 40px 0px 40px' }}>
    <Box style={{ flexDirection: 'row', gap: 24, height: 314 }}>
      <Box style={{ flex: 1.55, flexDirection: 'column', gap: 8 }}>
        <Image src="assets/nwp_vs_lmd.png" style={{ width: '100%', height: 300, objectFit: 'contain' }} />
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', gap: 12 }}>
        <Box style={{ flex: 1, flexDirection: 'column', background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '16px 18px', gap: 4 }}>
          <Text style={{ fontSize: 20, color: '#4A5568' }}>同时刻实测总辐射</Text>
          <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#1E4FA8' }}>2.4738</Text>
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '16px 18px', gap: 4 }}>
          <Text style={{ fontSize: 20, color: '#4A5568' }}>同时刻预报总辐射</Text>
          <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#D9534F' }}>4.8725</Text>
          <Text style={{ fontSize: 18, color: '#8B97A8' }}>同样十站、同样模型，误差涨 97%</Text>
        </Box>
      </Box>
    </Box>
    <Box style={{ marginTop: 18, flexDirection: 'row', gap: 18 }}>
      <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 8, padding: '16px 20px', flexDirection: 'column', gap: 4 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>为什么会翻倍：预报本身就散</Text>
        <Text style={{ fontSize: 19, color: '#4A5568', lineHeight: 1.5 }}>十站平均，预报总辐射的归一化 RMSE 是 0.4455，实测那条线基本贴着对角线，预报是一团雾。辐射不准，功率当然跟着飘。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 8, padding: '16px 20px', flexDirection: 'column', gap: 4 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>工程含义：先接气象，再换算法</Text>
        <Text style={{ fontSize: 19, color: '#4A5568', lineHeight: 1.5 }}>十站总装机 193.6 MW。两个设定的 MAE 差 4.64 MW —— 一个断面要拿 4.64 MW 备用去填，这比换什么模型都值钱。</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', right: 40, bottom: 24 }}>
    <Text style={{ fontSize: 16, color: '#1E4FA8' }}>08 / 13</Text>
  </Box>
</Slide>
