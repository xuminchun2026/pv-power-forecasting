<Slide style={{ padding: '0px' }}>
  <Box style={{ width: '100%', height: 10, background: '#0E3F8C' }} />
  <Box style={{ padding: '32px 40px 0px 40px' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1E4FA8' }}>汇报内容</Text>
  </Box>
  <Box style={{ padding: '22px 40px 0px 40px' }}>
    <Box style={{ flexDirection: 'column', gap: 18 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20 }}>
        <Box style={{ width: 46, height: 46, background: '#1E4FA8', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>01</Text>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>研究问题</Text>
          <Text style={{ fontSize: 19, color: '#4A5568' }}>我把"气象信息能不能拿到"设成了控制变量，而不是直接比模型</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20 }}>
        <Box style={{ width: 46, height: 46, background: '#1E4FA8', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>02</Text>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>实验数据</Text>
          <Text style={{ fontSize: 19, color: '#4A5568' }}>PVOD 河北 10 站一年记录，以及我发现并修掉的三处数据坑</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20 }}>
        <Box style={{ width: 46, height: 46, background: '#1E4FA8', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>03</Text>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>研究方法</Text>
          <Text style={{ fontSize: 19, color: '#4A5568' }}>四种信息设定 × 七种方法，全部按时间前 70% / 后 30% 切分</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20 }}>
        <Box style={{ width: 46, height: 46, background: '#1E4FA8', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>04</Text>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>实验结果</Text>
          <Text style={{ fontSize: 19, color: '#4A5568' }}>四个关键数字，以及"什么时候模型反而帮倒忙"</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 20 }}>
        <Box style={{ width: 46, height: 46, background: '#1E4FA8', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#FFFFFF' }}>05</Text>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
          <Text style={{ fontSize: 24, fontWeight: 'bold', color: '#1A2230' }}>不足与个人收获</Text>
          <Text style={{ fontSize: 19, color: '#4A5568' }}>我知道自己差在哪，也知道下一步该补什么</Text>
        </Box>
      </Box>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', right: 40, bottom: 24 }}>
    <Text style={{ fontSize: 16, color: '#1E4FA8' }}>02 / 13</Text>
  </Box>
</Slide>
