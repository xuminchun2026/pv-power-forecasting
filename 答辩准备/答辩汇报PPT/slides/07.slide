<Slide style={{ padding: '0px' }}>
  <Box style={{ width: '100%', height: 10, background: '#0E3F8C' }} />
  <Box style={{ padding: '30px 40px 0px 40px' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1E4FA8' }}>四、实验结果：十站平均误差，最好的只有 1.4942%</Text>
  </Box>
  <Box style={{ padding: '20px 40px 0px 40px' }}>
    <Box style={{ flexDirection: 'row', gap: 14, height: 268 }}>
      <Box style={{ flex: 1, flexDirection: 'column', background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '20px 18px', gap: 6 }}>
        <Text style={{ fontSize: 20, color: '#4A5568' }}>甲′　预报气象</Text>
        <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#1E4FA8' }}>4.8725</Text>
        <Text style={{ fontSize: 19, color: '#4A5568' }}>最优：随机森林</Text>
        <Text style={{ fontSize: 19, color: '#8B97A8' }}>比 Persistence 好 13.88%</Text>
        <Box style={{ marginTop: 'auto', background: '#E8EFF8', borderRadius: 6, padding: '8px 12px' }}>
          <Text style={{ fontSize: 18, color: '#1E4FA8' }}>最难的一档</Text>
        </Box>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '20px 18px', gap: 6 }}>
        <Text style={{ fontSize: 20, color: '#4A5568' }}>甲　实测气象</Text>
        <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#1E4FA8' }}>2.4738</Text>
        <Text style={{ fontSize: 19, color: '#4A5568' }}>最优：LightGBM</Text>
        <Text style={{ fontSize: 19, color: '#8B97A8' }}>比 Persistence 好 18.58%</Text>
        <Box style={{ marginTop: 'auto', background: '#E8EFF8', borderRadius: 6, padding: '8px 12px' }}>
          <Text style={{ fontSize: 18, color: '#1E4FA8' }}>换预报换实测，误差翻倍</Text>
        </Box>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', background: '#F0F5FC', border: '1px solid #D6DCE5', borderRadius: 8, padding: '20px 18px', gap: 6 }}>
        <Text style={{ fontSize: 20, color: '#4A5568' }}>乙　纯历史</Text>
        <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#1E4FA8' }}>2.2821</Text>
        <Text style={{ fontSize: 19, color: '#4A5568' }}>最优：LightGBM</Text>
        <Text style={{ fontSize: 19, color: '#8B97A8' }}>比 Persistence 好 11.57%</Text>
        <Box style={{ marginTop: 'auto', background: '#E8EFF8', borderRadius: 6, padding: '8px 12px' }}>
          <Text style={{ fontSize: 18, color: '#1E4FA8' }}>没有辐射，模型也能顶</Text>
        </Box>
      </Box>
      <Box style={{ flex: 1, flexDirection: 'column', background: '#E8EFF8', border: '2px solid #1E4FA8', borderRadius: 8, padding: '20px 18px', gap: 6 }}>
        <Text style={{ fontSize: 20, color: '#4A5568' }}>丙　气象 + 历史</Text>
        <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#0E3F8C' }}>1.4942</Text>
        <Text style={{ fontSize: 19, color: '#1E4FA8', fontWeight: 'bold' }}>最优：线性回归</Text>
        <Text style={{ fontSize: 19, color: '#4A5568' }}>比 Persistence 好 41.74%</Text>
        <Box style={{ marginTop: 'auto', background: '#FFC107', borderRadius: 6, padding: '8px 12px' }}>
          <Text style={{ fontSize: 18, color: '#1A2230', fontWeight: 'bold' }}>八个方法里它最好</Text>
        </Box>
      </Box>
    </Box>
    <Box style={{ marginTop: 18, flexDirection: 'row', gap: 20 }}>
      <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 8, padding: '16px 20px', flexDirection: 'column', gap: 4 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>训练耗时差了三千倍</Text>
        <Text style={{ fontSize: 19, color: '#4A5568', lineHeight: 1.5 }}>线性回归 0.003 秒，LightGBM 0.42 秒，随机森林 2.36 秒，LSTM 9.6 秒（单站四设定均值）。</Text>
      </Box>
      <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 8, padding: '16px 20px', flexDirection: 'column', gap: 4 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1A2230' }}>参数不是随手定的</Text>
        <Text style={{ fontSize: 19, color: '#4A5568', lineHeight: 1.5 }}>树模型统一 100 棵、学习率 0.1。我另外跑了 100 棵 vs 300 棵对照，十站均值反而从 2.2821 涨到 2.4538。</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', right: 40, bottom: 24 }}>
    <Text style={{ fontSize: 16, color: '#1E4FA8' }}>07 / 13</Text>
  </Box>
</Slide>
